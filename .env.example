# Copy to .env and replace both placeholders before starting Docker Compose.
# These credentials initialize MySQL only when the data volume is empty.
DB_PASSWORD=replace-with-your-local-solar-password
MYSQL_ROOT_PASSWORD=replace-with-your-local-root-password
# Test payments require an explicit local/test profile and never move real funds.
SPRING_PROFILES_ACTIVE=local
PAYMENTS_MOCK_ENABLED=false
