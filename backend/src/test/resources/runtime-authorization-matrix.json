{
  "version": 1,
  "title": "Runtime Role x Endpoint Authorization Matrix",
  "purpose": "Controller family scope metadata. Exact HTTP method, resolved route and controller operation are expanded from Spring's live RequestMappingHandlerMapping at test runtime; no route is inferred from a static annotation-only scan.",
  "sourceOfTruth": {
    "productRequirements": "saumya-solar-energy-solution-requirements.md",
    "srsHld": "saumya-solar-production-ready-srs-hld.md",
    "implementationPlan": "docs/implementation/DEVELOP_AUTHORIZATION_IMPLEMENTATION_PLAN.md",
    "gapAnalysis": "docs/security/DEVELOP_AUTHORIZATION_GAP_ANALYSIS.md"
  },
  "defaultResults": {
    "anonymousProtected": 401,
    "authenticatedMissingEffectivePermission": 403,
    "foreignTenantOrCustomerResource": 404,
    "invalidBusinessState": 409,
    "readOnlyMutation": 403
  },
  "actorProfiles": {
    "PLATFORM_SUPER_ADMIN": "Persisted users row plus all PLATFORM_* grants in platform_user_permissions; no tenant membership.",
    "PLATFORM_SUPPORT": "Persisted platform identity with PLATFORM_SUPPORT_ACCESS only; no tenant membership.",
    "VENDOR_ADMIN": "Persisted employee membership plus active tenant-owned vendor role assigned through employee_role_assignments; effective permissions come from vendor_role_permissions.",
    "CUSTOM_VENDOR_ROLE": "Persisted employee membership with a tenant-owned custom role containing only PRODUCT_VIEW; no hardcoded role-name authorization.",
    "POS_CASHIER": "Persisted employee role with POS operation grants and employee_register_assignments for the exact tenant branch/register.",
    "ACCOUNTANT": "Persisted employee role with report/refund/finance read and export permissions.",
    "CUSTOMER": "Persisted global user and customer_profiles row; no vendor membership.",
    "VIEW_ONLY": "Persisted vendor role containing only *_VIEW grants; must not authorize a mutation.",
    "NO_PERMISSION": "Persisted active vendor employee membership with no active employee_role_assignments.",
    "DISABLED": "Persisted disabled user and disabled employee membership; authentication must fail.",
    "WRONG_TENANT": "Persisted active employee and complete role in another tenant.",
    "WRONG_CUSTOMER": "Persisted global customer identity unrelated to the target customer resource.",
    "ANONYMOUS": "No bearer token."
  },
